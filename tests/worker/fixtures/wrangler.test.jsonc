{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "play-cms-worker-test",
  "main": "../../../src/worker.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/admin", "/admin/*", "/api/*", "/v/*"],
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "play-cms-worker-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../../migrations",
    },
    {
      "binding": "OLD_DATABASE",
      "database_name": "play-cms-worker-test-old",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../../migrations",
    },
    {
      "binding": "ROLLBACK_DATABASE",
      "database_name": "play-cms-worker-test-rollback",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../../migrations",
    },
  ],
}
