{
  "name": "@filma/play-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "build:verify": "PLAY_VERIFY_BUILD=true vite build",
    "build:ui": "vite build",
    "dev": "vite",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser:viewer-logout": "PLAY_VERIFY_BUILD=true vite build && node tests/browser/viewer-logout-account-switch.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply play-cms-local --local",
    "test:filma:live": "node --env-file-if-exists=.dev.vars ./node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "validate:reviewer-skill": "node scripts/validate-reviewer-skill.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm validate:reviewer-skill && pnpm test && pnpm test:worker && pnpm build:verify && pnpm format:check"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "4.1.6",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
